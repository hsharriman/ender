+Lemma half_sub (h : R) (H : h * (1 + 1) = 1) (x y : R) :
+  x - h * (x + y) = h * (x - y).
+Proof.
+have hh : h + h = 1 by rewrite -H mulrDr !mulr1.
+have hx : forall z : R, z - h * z = h * z.
+  by move=> z; apply/eqP; rewrite subr_eq -mulrDl hh mul1r.
+by rewrite mulrDr mulrBr opprD addrA hx.
+Qed.
