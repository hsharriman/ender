+Lemma half_perp (h u0 u1 v0 v1 a0 a1 : R) :
+  (u0 - a0) ^+ 2 + (u1 - a1) ^+ 2 = (v0 - a0) ^+ 2 + (v1 - a1) ^+ 2 ->
+  (h * (u0 - v0)) * (h * ((u0 - a0) + (v0 - a0)))
+  + (h * (u1 - v1)) * (h * ((u1 - a1) + (v1 - a1))) = 0.
+Proof.
+move=> E.
+have e : forall x y c : R, x - y = (x - c) - (y - c).
+  by move=> x y c; rewrite opprB addrA subrK.
+rewrite (e u0 v0 a0) (e u1 v1 a1).
+rewrite [X in X + _]mulrACA [X in _ + X]mulrACA -!subr_sqr -mulrDr.
+by rewrite addrACA -opprD E subrr mulr0.
+Qed.
