+Lemma half_mid (h : R) (H : h * (1 + 1) = 1) (x y a : R) :
+  h * (x + y) - a = h * ((x - a) + (y - a)).
+Proof.
+have hh : h + h = 1 by rewrite -H mulrDr !mulr1.
+by rewrite [RHS]mulrDr !mulrBr addrACA -opprD -mulrDl hh mul1r mulrDr.
+Qed.
